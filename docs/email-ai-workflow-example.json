      "typeVersion": 1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "mailbox": "INBOX",
        "format": "simple",
        "options": {
          "downloadAttachments": false,
          "markSeen": false
        }
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Read Recent Emails",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "imap": {
          "id": "your-imap-credential-id",
          "name": "Gmail IMAP"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition1",
              "leftValue": "={{ $json.subject }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Filter Valid Emails",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "model": "sonar-pro",
        "messages": {
          "message": [
            {
              "role": "system",
              "content": "You are a professional email assistant. Analyze the email content and provide:\n1. A brief summary (2-3 sentences)\n2. Key action items (if any)\n3. Sentiment analysis (positive/neutral/negative)\n4. Suggested response (if appropriate)\n\nFormat your response as JSON with these fields: summary, action_items, sentiment, suggested_response"
            },
            {
              "role": "user",
              "content": "Email Subject: {{ $json.subject }}\nFrom: {{ $json.from }}\nDate: {{ $json.date }}\nContent: {{ $json.text }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 300,
          "returnRelatedQuestions": false
        }
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Analyze Email with AI",
      "type": "n8n-nodes-base.perplexity",
      "typeVersion": 1,
      "position": [
        880,
        280
      ],
      "credentials": {
        "perplexityApi": {
          "id": "your-perplexity-credential-id",
          "name": "Perplexity API"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "Combine Email + AI Analysis",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition1",
              "leftValue": "={{ $json.sentiment }}",
              "rightValue": "negative",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "Check if Urgent Response Needed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "subject": "Urgent: Response needed - {{ $('Read Recent Emails').item.json.subject }}",
        "message": "An email requiring urgent attention has been received:\n\nFrom: {{ $('Read Recent Emails').item.json.from }}\nSubject: {{ $('Read Recent Emails').item.json.subject }}\n\nAI Analysis:\n{{ $('Analyze Email with AI').item.json.choices[0].message.content }}\n\nPlease review and respond accordingly.",
        "options": {}
      },
      "id": "77777777-7777-7777-7777-777777777777",
      "name": "Send Urgent Notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1540,
        200
      ],
      "credentials": {
        "smtp": {
          "id": "your-smtp-credential-id",
          "name": "Gmail SMTP"
        }
      }
    },
    {
      "parameters": {
        "model": "sonar-reasoning",
        "messages": {
          "message": [
            {
              "role": "system",
              "content": "Generate a professional, helpful email response based on the original email content and analysis provided. Keep it concise and appropriate to the context."
            },
            {
              "role": "user",
              "content": "Original email:\nSubject: {{ $('Read Recent Emails').item.json.subject }}\nFrom: {{ $('Read Recent Emails').item.json.from }}\nContent: {{ $('Read Recent Emails').item.json.text }}\n\nAI Analysis: {{ $('Analyze Email with AI').item.json.choices[0].message.content }}\n\nGenerate an appropriate response email."
            }
          ]
        },
        "options": {
          "temperature": 0.5,
          "maxTokens": 200
        }
      },
      "id": "88888888-8888-8888-8888-888888888888",
      "name": "Generate AI Response",
      "type": "n8n-nodes-base.perplexity",
      "typeVersion": 1,
      "position": [
        1540,
        400
      ],
      "credentials": {
        "perplexityApi": {
          "id": "your-perplexity-credential-id",
          "name": "Perplexity API"
        }
      }
    },
    {
      "parameters": {
        "subject": "Re: {{ $('Read Recent Emails').item.json.subject }}",
        "toEmail": "={{ $('Read Recent Emails').item.json.from }}",
        "message": "{{ $json.choices[0].message.content }}\n\n---\nThis is an AI-generated response. Please review before sending.",
        "options": {}
      },
      "id": "99999999-9999-9999-9999-999999999999",
      "name": "Draft AI Response Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1760,
        400
      ],
      "credentials": {
        "smtp": {
          "id": "your-smtp-credential-id",
          "name": "Gmail SMTP"
        }
      }
    }
